# Normalise all text files to LF in the repo (Unix line endings)
# so YAML/shell files work correctly on Linux (EKS, GitHub Actions runners).
* text=auto eol=lf

# Shell scripts must always be LF — CRLF breaks bash on Linux
*.sh text eol=lf

# YAML / JSON
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf

# Markdown
*.md text eol=lf

# Binary files — no line ending conversion
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
